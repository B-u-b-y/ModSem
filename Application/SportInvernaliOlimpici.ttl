:appartieneASport a owl:ObjectProperty ;
    rdfs:domain :Gara ;
    rdfs:range :Sport .

:haData a owl:DatatypeProperty ;
    rdfs:range xsd:date .

:haEta a owl:DatatypeProperty ;
    rdfs:range xsd:integer .

:haNome a owl:DatatypeProperty ;
    rdfs:range xsd:string .

:haPartecipante a owl:ObjectProperty ;
    rdfs:domain :Gara ;
    rdfs:range :Atleta ;
    owl:inverseOf :partecipaAGara .

:haPunteggio a owl:DatatypeProperty ;
    rdfs:range xsd:float .

:partecipaAGaraInLuogo a owl:ObjectProperty ;
    owl:propertyChainAxiom ( :partecipaAGara :siSvolgeIn ) .

:precedeEdizione a owl:ObjectProperty,
        owl:TransitiveProperty .

owl:minQualifiedCardinality a owl:AnnotationProperty .

skos:closeMatch a owl:AnnotationProperty .

skos:exactMatch a owl:AnnotationProperty .

:Bronzo a :TipoMedaglia,
        owl:NamedIndividual .

:Evento a owl:Class .

:GaraOlimpica a owl:Class ;
    rdfs:subClassOf :Gara .

:ImpiantoSportivo a owl:Class ;
    rdfs:subClassOf :Luogo .

:PattinaggioSport a :SportInvernale,
        owl:NamedIndividual ;
    rdfs:label "Pattinaggio"@it .

:Persona a owl:Class ;
    rdfs:label "Persona"@it ;
    skos:exactMatch foaf:Person .

:SciDiFondoSport a :SportInvernale,
        owl:NamedIndividual ;
    rdfs:label "Sci di Fondo"@it .

:garaDi a owl:ObjectProperty ;
    rdfs:domain :Gara ;
    rdfs:range :Sport .

:praticaSport a owl:ObjectProperty ;
    rdfs:domain :Atleta ;
    rdfs:range :Sport ;
    owl:propertyChainAxiom ( :partecipaAGara :garaDi ) .

:siSvolgeIn a owl:ObjectProperty ;
    rdfs:domain :Gara ;
    rdfs:range :Luogo .

:vinceMedaglia a owl:ObjectProperty ;
    rdfs:domain :Atleta ;
    rdfs:range :TipoMedaglia .

xsd:date a rdfs:Datatype .

:AtletaInvernale a owl:Class ;
    rdfs:subClassOf :Atleta ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Atleta [ a owl:Restriction ;
                        owl:onProperty :praticaSport ;
                        owl:someValuesFrom :SportInvernale ] ) ] .

:Luogo a owl:Class ;
    rdfs:label "Luogo"@it ;
    skos:closeMatch dbpedia-owl:Place .

:Sci a owl:Class ;
    rdfs:subClassOf :SportInvernale .

:SnowboardSport a :SportInvernale,
        owl:NamedIndividual ;
    rdfs:label "Snowboard"@it .

:Argento a :TipoMedaglia,
        owl:NamedIndividual .

:Sport a owl:Class ;
    rdfs:label "Sport"@it .

:partecipaAGara a owl:ObjectProperty ;
    rdfs:domain :Atleta ;
    rdfs:range :Gara .

:TipoMedaglia a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( :Argento :Bronzo :Oro ) ] .

:Gara a owl:Class ;
    rdfs:subClassOf :Evento .

:Atleta a owl:Class ;
    rdfs:subClassOf :Persona ;
    skos:closeMatch dbpedia-owl:Athlete .

:SciAlpinoSport a :SportInvernale,
        owl:NamedIndividual ;
    rdfs:label "Sci Alpino"@it .

:SportInvernale a owl:Class ;
    rdfs:subClassOf :Sport .

:Medagliato a owl:Class ;
    rdfs:subClassOf :AtletaInvernale ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Atleta [ a owl:Restriction ;
                        owl:onProperty :vinceMedaglia ;
                        owl:someValuesFrom :TipoMedaglia ] ) ] .

:Oro a :TipoMedaglia,
        owl:NamedIndividual .

:AtletaOlimpico a owl:Class ;
    rdfs:subClassOf :AtletaInvernale ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Atleta [ a owl:Restriction ;
                        owl:onProperty :partecipaAGara ;
                        owl:someValuesFrom :GaraOlimpica ] ) ] .

[] owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger .

