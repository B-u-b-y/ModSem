@prefix : <http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/> .
@prefix dbpedia-owl: <http://dbpedia.org/ontology/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dc:creator a owl:AnnotationProperty .

dc:date a owl:AnnotationProperty .

dc:description a owl:AnnotationProperty .

dc:title a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

<http://www.semanticweb.org/ModSem/SportInvernaliOlimpici> a owl:Ontology ;
    rdfs:label "Ontologia Sport Invernali Olimpici"@it ;
    dc:creator "Budaes Tanaru Riccardo Gabriele",
        "Driza Andrea" ;
    dc:date "2026-01-20"^^xsd:date ;
    dc:description "Ontologia sugli sport invernali olimpici."@it ;
    dc:title "Ontologia completa degli sport invernali olimpici"@it ;
    vann:preferredNamespacePrefix "SIO" ;
    vann:preferredNamespaceUri "http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/" .

:AnjaParson a :AtletaOlimpico,
        :Medagliato,
        owl:NamedIndividual ;
    :haEta 45 ;
    :haNome "Anja Pärson" ;
    :praticaSport :SciAlpinoSport ;
    :vinceMedaglia :Oro .

:AtletaMedagliatoOlimpico a owl:Class ;
    rdfs:label "Atleta Medagliato Olimpico"@it ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :AtletaOlimpico :Medagliato ) ] .

:Biathlon a owl:Class ;
    rdfs:subClassOf :SportInvernale .

:BiathlonSport a :SportInvernale,
        owl:NamedIndividual ;
    rdfs:label "Biathlon"@it .

