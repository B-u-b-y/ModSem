@prefix : <http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix dbpedia-owl: <http://dbpedia.org/ontology/> .
@base <http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/> .

<http://www.semanticweb.org/ModSem/SportInvernaliOlimpici> rdf:type owl:Ontology ;
                                                            dc:creator "Budaes Tanaru Riccardo Gabriele" ,
                                                                       "Driza Andrea" ;
                                                            dc:date "2026-01-20"^^xsd:date ;
                                                            dc:description "Ontologia sugli sport invernali olimpici, che rappresenta atleti, gare olimpiche, tipologie di medaglie, discipline sportive e luoghi di svolgimento, con informazioni su partecipazioni e risultati."@it ;
                                                            dc:title "Sport Invernali Olimpici - Ontologia completa degli sport invernali olimpici"@it ;
                                                            vann:preferredNamespacePrefix "SIO" ;
                                                            vann:preferredNamespaceUri "http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/" ;
                                                            rdfs:label "Sport Invernali Olimpici"@it .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/creator
dc:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/date
dc:date rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/description
dc:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/title
dc:title rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
vann:preferredNamespacePrefix rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
vann:preferredNamespaceUri rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#minQualifiedCardinality
owl:minQualifiedCardinality rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#closeMatch
skos:closeMatch rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#exactMatch
skos:exactMatch rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/assegnataInGara
:assegnataInGara rdf:type owl:ObjectProperty ;
                 owl:inverseOf :haMedaglia ;
                 rdfs:domain :Medaglia ;
                 rdfs:range :Gara ;
                 rdfs:comment "Indica la gara in cui è stata assegnata una medaglia, collegando direttamente la medaglia all'evento."@it ;
                 rdfs:label "assegnataInGara"@it .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/assegnataPer
:assegnataPer rdf:type owl:ObjectProperty ;
              rdfs:domain :Medaglia ;
              rdfs:range :Sport ;
              rdfs:comment "Specifica lo sport per il quale una medaglia è stata assegnata, collegando il tipo di medaglia alla disciplina pertinente."@it ;
              rdfs:label "assegnataPer"@it .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/garaDi
:garaDi rdf:type owl:ObjectProperty ;
        rdfs:domain :Gara ;
        rdfs:range :Sport ;
        rdfs:comment "Associa una gara a uno sport specifico, definendo la disciplina sportiva di appartenenza della competizione."@it ;
        rdfs:label "garaDi"@it .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/haMedaglia
:haMedaglia rdf:type owl:ObjectProperty ;
            rdfs:domain :Sport ;
            rdfs:range :Medaglia ;
            rdfs:comment "Indica le medaglie assegnate per uno sport specifico."@it ;
            rdfs:label "haMedaglia"@it .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/haPartecipante
:haPartecipante rdf:type owl:ObjectProperty ;
                owl:inverseOf :partecipaAGara ;
                rdfs:domain :Gara ;
                rdfs:range :Atleta ;
                rdfs:comment "Indica gli atleti che partecipano a una gara, collegando la competizione ai relativi partecipanti."@it ;
                rdfs:label "haPartecipante"@it .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/haTipo
:haTipo rdf:type owl:ObjectProperty ;
        rdfs:domain :Medaglia ;
        rdfs:range :TipoMedaglia ;
        rdfs:comment "Indica il tipo (Oro/Argento/Bronzo) di una medaglia."@it ;
        rdfs:label "haTipo"@it .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/haVinto
:haVinto rdf:type owl:ObjectProperty ;
         owl:inverseOf :haVintoInSport ;
         rdfs:domain :Sport ;
         rdfs:range :Atleta ;
         rdfs:comment "Collega uno sport agli atleti che hanno vinto medaglie in quella disciplina."@it ;
         rdfs:label "haVinto"@it .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/haVintoInSport
:haVintoInSport rdf:type owl:ObjectProperty ;
                owl:propertyChainAxiom ( :vinceMedaglia
                                         :assegnataPer
                                       ) ;
                rdfs:comment "Collega un atleta allo sport in cui ha vinto una medaglia, passando dall'istanza di medaglia alla disciplina sportiva assegnata."@it ;
                rdfs:label "haVintoInSport"@it .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/luogoDiGara
:luogoDiGara rdf:type owl:ObjectProperty ;
             owl:inverseOf :siSvolgeIn ;
             rdfs:domain :Luogo ;
             rdfs:range :Gara ;
             rdfs:comment "Indica le gare che si svolgono in un luogo specifico."@it ;
             rdfs:label "luogoDiGara"@it .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/partecipaAGara
:partecipaAGara rdf:type owl:ObjectProperty ;
                rdfs:domain :Atleta ;
                rdfs:range :Gara ;
                rdfs:comment "Indica le gare a cui un atleta partecipa, permettendo di tracciare la sua partecipazione alle competizioni."@it ;
                rdfs:label "partecipaAGara"@it .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/partecipaAGaraInLuogo
:partecipaAGaraInLuogo rdf:type owl:ObjectProperty ;
                       owl:propertyChainAxiom ( :partecipaAGara
                                                :siSvolgeIn
                                              ) ;
                       rdfs:comment "Determina il luogo in cui un atleta ha partecipato a una gara, tramite la relazione tra partecipazione e luogo di svolgimento."@it ;
                       rdfs:label "partecipaAGaraInLuogo"@it .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/praticaSport
:praticaSport rdf:type owl:ObjectProperty ;
              rdfs:domain :Atleta ;
              rdfs:range :Sport ;
              owl:propertyChainAxiom ( :partecipaAGara
                                       :garaDi
                                     ) ;
              rdfs:comment "Specifica lo sport praticato da un atleta, deducibile dalle gare a cui partecipa."@it ;
              rdfs:label "praticaSport"@it .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/precedeEdizione
:precedeEdizione rdf:type owl:ObjectProperty ,
                          owl:TransitiveProperty ;
                 rdfs:comment "Relazione transitiva che indica che un'edizione di un evento precede un'altra, utile per ordinare cronologicamente le edizioni."@it ;
                 rdfs:label "precedeEdizione"@it .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/siSvolgeIn
:siSvolgeIn rdf:type owl:ObjectProperty ;
            rdfs:domain :Gara ;
            rdfs:range :Luogo ;
            rdfs:comment "Indica il luogo fisico in cui si svolge una gara o un evento sportivo, come città, località o impianto."@it ;
            rdfs:label "siSvolgeIn"@it .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/vinceMedaglia
:vinceMedaglia rdf:type owl:ObjectProperty ;
               rdfs:domain :Atleta ;
               rdfs:range :Medaglia ;
               rdfs:comment "Collega un atleta a una specifica istanza di medaglia vinta in una competizione."@it ;
               rdfs:label "vinceMedaglia"@it .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/haData
:haData rdf:type owl:DatatypeProperty ;
        rdfs:range xsd:date ;
        rdfs:comment "Indica la data di svolgimento di un evento o gara."@it ;
        rdfs:label "haData"@it .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/haEta
:haEta rdf:type owl:DatatypeProperty ;
       rdfs:range xsd:integer ;
       rdfs:comment "Indica l'età di un atleta o di una persona."@it ;
       rdfs:label "haEta"@it .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/haNome
:haNome rdf:type owl:DatatypeProperty ,
                 owl:FunctionalProperty ;
        rdfs:range xsd:string ;
        rdfs:comment "Specifica il nome proprio di una persona o atleta."@it ;
        rdfs:label "haNome"@it .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/haPunteggio
:haPunteggio rdf:type owl:DatatypeProperty ;
             rdfs:range xsd:float ;
             rdfs:comment "Indica il punteggio ottenuto da un atleta in una gara o competizione."@it ;
             rdfs:label "haPunteggio"@it .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/Atleta
:Atleta rdf:type owl:Class ;
        rdfs:subClassOf :Persona ;
        rdfs:comment "Rappresenta una persona che pratica uno sport, indipendentemente dal livello di competizione, includendo professionisti e dilettanti."@it ;
        rdfs:label "Atleta"@it ;
        skos:closeMatch dbpedia-owl:Athlete .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/AtletaInvernale
:AtletaInvernale rdf:type owl:Class ;
                 rdfs:subClassOf :Atleta ;
                 rdfs:comment "Rappresenta un atleta che pratica almeno uno sport invernale, come sci, snowboard o pattinaggio, comprendendo sia competizioni nazionali che internazionali."@it ;
                 rdfs:label "AtletaInvernale"@it .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/AtletaMedagliatoOlimpico
:AtletaMedagliatoOlimpico rdf:type owl:Class ;
                          rdfs:subClassOf :AtletaOlimpico ,
                                          :Medagliato ;
                          rdfs:comment "Rappresenta un atleta che ha partecipato ai Giochi Olimpici Invernali ed ha vinto almeno una medaglia."@it ;
                          rdfs:label "Atleta Medagliato Olimpico"@it .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/AtletaOlimpico
:AtletaOlimpico rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( :Atleta
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty :partecipaAGara ;
                                                             owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                             owl:onClass :GaraOlimpica
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf :Atleta ;
                rdfs:comment "Rappresenta un atleta che ha partecipato ad almeno una gare dei Giochi Olimpici Invernali."@it ;
                rdfs:label "AtletaOlimpico"@it .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/AtletaPlurimedagliato
:AtletaPlurimedagliato rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty :vinceMedaglia ;
                                             owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                                             owl:onClass :Medaglia
                                           ] ;
                       rdfs:subClassOf :Atleta ;
                       rdfs:comment "Atleta che ha ricevuto più di una medaglia"@it ;
                       rdfs:label "AtletaPlurimedagliato"@it .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/Biathlon
:Biathlon rdf:type owl:Class ;
          rdfs:subClassOf :SportInvernale ;
          rdfs:comment "Rappresenta la disciplina sportiva del biathlon, che combina sci di fondo e tiro a segno con carabina, tipica dei Giochi Olimpici Invernali."@it ;
          rdfs:label "Biathlon"@it .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/Evento
:Evento rdf:type owl:Class ;
        rdfs:comment "Rappresenta qualsiasi evento legato agli sport invernali olimpici, incluse gare e competizioni, con informazioni su luoghi, partecipanti e discipline sportive coinvolte."@it ;
        rdfs:label "Evento"@it .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/Gara
:Gara rdf:type owl:Class ;
      rdfs:subClassOf :Evento ;
      rdfs:comment "Rappresenta una gara sportiva invernale, inclusiva di informazioni su partecipanti, disciplina, medaglie assegnate e luogo di svolgimento."@it ;
      rdfs:label "Gara"@it .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/GaraOlimpica
:GaraOlimpica rdf:type owl:Class ;
              rdfs:subClassOf :Gara ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :haPartecipante ;
                                owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass :Atleta
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :siSvolgeIn ;
                                owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass :Luogo
                              ] ;
              rdfs:comment "Rappresenta una gara che fa parte dei Giochi Olimpici Invernali, con dettagli su atleti partecipanti, risultati e medaglie."@it ;
              rdfs:label "GaraOlimpica"@it .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/ImpiantoOlimpico
:ImpiantoOlimpico rdf:type owl:Class ;
                  rdfs:subClassOf :ImpiantoSportivo ;
                  rdfs:comment "Rappresenta un impianto sportivo utilizzato per le competizioni olimpiche invernali, con caratteristiche idonee a ospitare gare di livello internazionale."@it ;
                  rdfs:label "ImpiantoOlimpico"@it .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/ImpiantoSportivo
:ImpiantoSportivo rdf:type owl:Class ;
                  rdfs:subClassOf :Luogo ;
                  rdfs:comment "Rappresenta un impianto o struttura attrezzata per la pratica di uno o più sport, inclusi sci, pattinaggio e altre discipline invernali."@it ;
                  rdfs:label "ImpiantoSportivo"@it .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/Luogo
:Luogo rdf:type owl:Class ;
       rdfs:comment "Rappresenta qualsiasi luogo fisico dove si possono svolgere eventi o attività sportive invernali, incluse città, località e impianti sportivi."@it ;
       rdfs:label "Luogo"@it ;
       skos:closeMatch dbpedia-owl:Place .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/Medaglia
:Medaglia rdf:type owl:Class ;
          rdfs:comment "Rappresenta qualsiasi medaglia assegnata agli atleti nelle competizioni sportive, indipendentemente dal tipo o dalla disciplina."@it ;
          rdfs:label "Medaglia"@it .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/Medagliato
:Medagliato rdf:type owl:Class ;
            owl:equivalentClass [ owl:intersectionOf ( :Atleta
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :vinceMedaglia ;
                                                         owl:someValuesFrom :Medaglia
                                                       ]
                                                     ) ;
                                  rdf:type owl:Class
                                ] ;
            rdfs:subClassOf :Atleta ;
            rdfs:comment "Rappresenta un atleta che ha ricevuto almeno una medaglia in una competizione olimpica, indipendentemente dal tipo o dalla disciplina sportiva."@it ;
            rdfs:label "Medagliato"@it .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/Pattinaggio
:Pattinaggio rdf:type owl:Class ;
             rdfs:subClassOf :SportInvernale .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/Persona
:Persona rdf:type owl:Class ;
         rdfs:comment "Rappresenta un individuo umano, senza distinzione di ruolo o disciplina sportiva, e costituisce la classe base per tutti gli atleti."@it ;
         rdfs:label "Persona"@it ;
         skos:exactMatch foaf:Person .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/Sci
:Sci rdf:type owl:Class ;
     rdfs:subClassOf :SportInvernale ;
     rdfs:comment "Rappresenta la disciplina sportiva dello sci, comprensiva di sci alpino, sci di fondo e altre varianti invernali."@it ;
     rdfs:label "Sci"@it .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/SciAlpino
:SciAlpino rdf:type owl:Class ;
           rdfs:subClassOf :Sci .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/SciDiFondo
:SciDiFondo rdf:type owl:Class ;
            rdfs:subClassOf :Sci ;
            rdfs:comment "Rappresenta la disciplina sportiva dello sci di fondo, in cui gli atleti percorrono lunghe distanze su piste preparate."@it ;
            rdfs:label "SciDiFondo"@it .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/Snowboard
:Snowboard rdf:type owl:Class ;
           rdfs:subClassOf :SportInvernale ;
           rdfs:comment "Rappresenta la disciplina sportiva dello snowboard, includendo specialità come halfpipe, slopestyle, snowboard cross e parallelo."@it ;
           rdfs:label "Snowboard"@it .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/Sport
:Sport rdf:type owl:Class ;
       rdfs:comment "Rappresenta qualsiasi disciplina sportiva, sia estiva che invernale, senza distinzione di livello o modalità di svolgimento."@it ;
       rdfs:label "Sport"@it .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/SportInvernale
:SportInvernale rdf:type owl:Class ;
                rdfs:subClassOf :Sport ;
                rdfs:comment "Rappresenta qualsiasi disciplina sportiva praticata su neve o ghiaccio."@it ;
                rdfs:label "SportInvernale"@it .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/TipoMedaglia
:TipoMedaglia rdf:type owl:Class ;
              owl:equivalentClass [ rdf:type owl:Class ;
                                    owl:oneOf ( :Argento
                                                :Bronzo
                                                :Oro
                                              )
                                  ] ;
              rdfs:subClassOf :Medaglia ;
              rdfs:comment "Rappresenta i diversi tipi di medaglie che possono essere assegnate, come Oro, Argento e Bronzo, con indicazione della disciplina sportiva relativa."@it ;
              rdfs:label "TipoMedaglia"@it .


#################################################################
#    Individuals
#################################################################

###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/AnjaParson
:AnjaParson rdf:type owl:NamedIndividual ,
                     :AtletaInvernale ,
                     :AtletaMedagliatoOlimpico ,
                     :AtletaOlimpico ,
                     :Medagliato ;
            :partecipaAGara :GaraSciAlpino2022 ;
            :praticaSport :SciAlpino2022 ;
            :vinceMedaglia :MedagliaOroSciAlpino2022 ;
            :haEta 45 ;
            :haNome "Anja Pärson" ;
            rdfs:label "Anja Parson"@it .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/Argento
:Argento rdf:type owl:NamedIndividual ,
                  :TipoMedaglia ;
         rdfs:label "Argento"@it .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/Bronzo
:Bronzo rdf:type owl:NamedIndividual ,
                 :TipoMedaglia ;
        rdfs:label "Bronzo"@it .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/Cortina
:Cortina rdf:type owl:NamedIndividual ,
                  :Luogo ;
         rdfs:label "Cortina d'Ampezzo"@it .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/FedericaBrignone
:FedericaBrignone rdf:type owl:NamedIndividual ,
                           :AtletaInvernale ,
                           :AtletaMedagliatoOlimpico ,
                           :AtletaOlimpico ,
                           :Medagliato ;
                  :partecipaAGara :GaraSciAlpino2022 ;
                  :praticaSport :SciAlpino2022 ;
                  :vinceMedaglia :MedagliaArgentoSciAlpino2022 ;
                  :haEta 32 ;
                  :haNome "Federica Brignone" ;
                  rdfs:label "Federica Brignone"@it .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/GaraPattinaggio2006
:GaraPattinaggio2006 rdf:type owl:NamedIndividual ,
                              :GaraOlimpica ;
                     :siSvolgeIn :Sestriere ;
                     rdfs:label "Gara Pattinaggio 2006"@it .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/GaraPattinaggio2022
:GaraPattinaggio2022 rdf:type owl:NamedIndividual ,
                              :GaraOlimpica ;
                     :garaDi :Pattinaggio2022 ;
                     :siSvolgeIn :Pechino ;
                     :haData "2022-02-12"^^xsd:date ;
                     rdfs:label "Gara Pattinaggio 2022"@it .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/GaraPattinaggio2026
:GaraPattinaggio2026 rdf:type owl:NamedIndividual ,
                              :GaraOlimpica ;
                     :siSvolgeIn :Torino ;
                     rdfs:label "Gara Pattinaggio 2026"@it .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/GaraSciAlpino2022
:GaraSciAlpino2022 rdf:type owl:NamedIndividual ,
                            :GaraOlimpica ;
                   :garaDi :SciAlpino2022 ;
                   :siSvolgeIn :Yanqing ;
                   :haData "2022-02-10"^^xsd:date ;
                   rdfs:label "Gara Sci Alpino 2022"@it .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/GaraSciDiFondo2018
:GaraSciDiFondo2018 rdf:type owl:NamedIndividual ,
                             :GaraOlimpica ;
                    :garaDi :SciDiFondo2022 ;
                    :siSvolgeIn :Pechino ;
                    :haData "2018-02-15"^^xsd:date ;
                    rdfs:label "Gara Sci di Fondo 2018"@it .


###  http://www.semanticweb.org/ModSem/SportInvernaliOlimpici/GaraSciDiFondo2022
:GaraSciDiFondo2022 rdf:type owl:NamedIndividual ,
                             :GaraOlimpica ;
