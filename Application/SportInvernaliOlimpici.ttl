        owl:NamedIndividual ;
    :haEta 27 ;
    :haNome "Nathan Chen" ;
    :praticaSport :PattinaggioSport ;
    :vinceMedaglia :Oro .

:Pattinaggio a owl:Class ;
    rdfs:subClassOf :SportInvernale .

